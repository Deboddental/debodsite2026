    { "source": "/blog/uncategorized/dolor-de-muelas-de-juicio-en-arguelles-madrid/", "destination": "/blog/salud-dental/dolor-de-muelas-de-juicio-en-arguelles-madrid/", "permanent": true },
    { "source": "/en/blog/general/deep-dental-cleaning-explained-arguelles-madrid/", "destination": "/en/blog/dental-health/deep-dental-cleaning-explained-arguelles-madrid/", "permanent": true },
    { "source": "/en/blog/general/wisdom-tooth-pain-arguelles-madrid/", "destination": "/en/blog/dental-health/wisdom-tooth-pain-arguelles-madrid/", "permanent": true },

    { "source": "/servicios/", "destination": "/tratamientos/", "permanent": true },
