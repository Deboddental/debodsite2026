    { "source": "/en/services/", "destination": "/en/treatments/", "permanent": true },
    { "source": "/en/services/:path*", "destination": "/en/treatments/", "permanent": true },
    { "source": "/dentista-general-arguelles-madrid-espana/", "destination": "/tratamientos/", "permanent": true },
    { "source": "/dentista-cosmetico-arguelles-madrid-espana/", "destination": "/tratamientos/", "permanent": true },
    { "source": "/dentista-de-implantes-arguelles-madrid-espana/", "destination": "/tratamientos/", "permanent": true },
