    { "source": "/privacy-policy", "destination": "/politica-de-privacidad/", "permanent": true },
    { "source": "/contact/", "destination": "/contacto/", "permanent": true },
    { "source": "/contact", "destination": "/contacto/", "permanent": true },
    { "source": "/en/privacy/", "destination": "/en/privacy-policy/", "permanent": true },
    { "source": "/en/privacy", "destination": "/en/privacy-policy/", "permanent": true },
    { "source": "/en/terms/", "destination": "/en/privacy-policy/", "permanent": true },
    { "source": "/en/terms", "destination": "/en/privacy-policy/", "permanent": true },
    { "source": "/en/about", "destination": "/en/about/", "permanent": true },

